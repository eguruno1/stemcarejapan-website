# ---------- CORS ----------
WEBSITE_ORIGIN=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3100

# ---------- Admin app ----------
NEXT_PUBLIC_API_URL=http://localhost:4000

# 번역 제공자는 운영자 설정 화면에서 선택한다. API 서버에서 접근하는 주소다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
