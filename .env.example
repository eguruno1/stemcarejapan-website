# ---------- API ----------
NODE_ENV=development
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000

# ---------- Database ----------
DATABASE_URL=postgresql://stemcare:stemcare@localhost:5434/stemcare_chat
TEST_DATABASE_URL=postgresql://stemcare:stemcare@localhost:5434/stemcare_chat_test

# ---------- Auth ----------
JWT_SECRET=change-this-in-production
