{
  "name": "stemcarejapan-consulting-chat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/admin",
    "test": "npm run test -w apps/api",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "test:widget": "vitest run --config tests/widget/vitest.config.mts",
    "test:admin": "npm run test -w apps/admin",
    "pretest:e2e": "npm run build -w packages/shared && npm run build -w apps/api",
    "pretest:e2e:ui": "npm run build -w packages/shared && npm run build -w apps/api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
