# 이 파일을 .env 로 복사하고 실제 값을 채운다. .env 는 절대 Git 에 올리지 않는다.

DOMAIN=chat.stemcarejapan.example

POSTGRES_USER=stemcare
POSTGRES_PASSWORD=여기에-긴-무작위-비밀번호
POSTGRES_DB=stemcare_chat

# openssl rand -base64 48 로 생성한다. 32자 이상이어야 서버가 뜬다.
JWT_SECRET=여기에-48바이트-무작위-문자열

OPENAI_API_KEY=sk-...
AI_MODEL=gpt-5-mini
TRANSLATION_MODEL=gpt-5-mini

# 초기 관리자 계정 (첫 배포 후 반드시 비밀번호를 변경한다)
SEED_ADMIN_EMAIL=admin@stemcarejapan.example
SEED_ADMIN_PASSWORD=첫-로그인-후-반드시-변경
